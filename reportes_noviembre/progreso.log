import re,html,json,os
L=json.load(open('listado.json'))
allp=[('MAT',p) for p in L['mat']]+[('VES',p) for p in L['ves']]
bodies={}
for ed,p in allp:
    cod=re.search(r'codigo=(\d+)',p['url']).group(1)
    d=open(f'notas/{cod}.html',encoding='utf-8',errors='replace').read()
    d=re.sub(r'(?s)<script.*?</script>','',d)
    d=re.sub(r'(?s)<style.*?</style>','',d)
    d=re.sub(r'(?s)<!--.*?-->','',d)
    i=d.find('DOF: 18/11/2026')
    j=d.find('AVISO LEGAL',i)
    seg=d[i:j]
    txt=re.sub(r'<[^>]*>','\n',seg)
    txt=html.unescape(txt)
    lines=[re.sub(r'[ \t]+',' ',x).strip() for x in txt.split('\n')]
    lines=[x for x in lines if x]
    bodies[cod]=lines
    print('='*100); print(ed,cod,'|',p['titulo'][:110]); print('LINES',len(lines))
    print('\n'.join(lines[1:14])[:900])
json.dump(bodies,open('bodies.json','w'),ensure_ascii=False)
