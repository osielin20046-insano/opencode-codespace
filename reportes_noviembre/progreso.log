TOP={'t-gap','t-leg','t-ef','t-fis','t-cex','t-sal','t-edu','t-tra','t-ene','t-marn','t-inf','t-tel','t-seg','t-agr','t-viv','t-pso','t-ind','t-nom','t-lic','t-con'}
TIPOS={'indicador_diario','nom','acuerdo','convocatoria','decreto','aviso','reglamento','resolucion','circular','manual','lineamiento','iniciativa','dictamen','minuta','proposicion','punto_de_acuerdo','comunicacion','gaceta','otro'}
pubs=[p for e in d['ediciones'] for p in e['publicaciones']]
cards=d['tarjetas']
assert len(pubs)==d['reporte']['totales']['publicaciones']==24
assert len(cards)==d['reporte']['totales']['tarjetas']==24
assert sum(len(p['reformas']) for p in pubs)==d['reporte']['totales']['reformas']==32
for p in pubs:
    assert p['fecha_publicacion']=='2026-11-18'
    assert p['url_oficial'].startswith('https://dof.gob.mx/nota_detalle.php?codigo='+p['identificador_oficial'])
    assert p['url_documento'].startswith('https://dof.gob.mx/nota_to_imagen_fs.php?codnota='+p['identificador_oficial'])
    assert p['tipo_publicacion'] in TIPOS
    assert p['clasificacion_reforma'] in ('reforma_normativa','no_aplica','por_revisar')
    assert p['titulo'] and p['dependencia']
    def walk(o):
        if isinstance(o,dict):
            for v in o.values(): walk(v)
        elif isinstance(o,list):
            for v in o: walk(v)
        elif isinstance(o,str): assert o.strip()!='', o
    walk(p)
for t in cards:
    assert t['fecha_publicacion']=='2026-11-18'
    assert t['topico_principal']['clave'] in TOP
    assert len(t['topicos_secundarios'])<=3
    assert t['nivel_impacto'] in ('critico','alto','medio','bajo')
    assert t['tipo_publicacion'] in TIPOS
    assert isinstance(t['accion_requerida'],bool)
    assert 3<=len(t['puntos_clave'])<=5
    assert [x['perfil'] for x in t['perfiles']]==['CE','FC','LC','L','GA']
    for pr in t['perfiles']:
        assert isinstance(pr['relevante'],bool)
        if pr['relevante']:
            n=len(pr['resumen'].split()); assert 80<=n<=120,(t['ref_tarjeta'],pr['perfil'],n)
            assert pr['accion_recomendada'] and pr['resumen']
        else:
            assert pr['resumen'] is None and pr['accion_recomendada'] is None
pids={p['ref_publicacion'] for p in pubs}; tids={t['ref_tarjeta'] for t in cards}
for p in pubs: assert len(p['id_tarjetas'])>=1 and set(p['id_tarjetas'])<=tids
for t in cards: assert set(t['publicaciones_origen'])<=pids
used=set()
for t in cards: used|=set(t['publicaciones_origen'])
assert used==pids
src=d['fuentes'][0]
assert src['n_ediciones']==len(d['ediciones']) and src['n_publicaciones']==len(pubs) and src['n_tarjetas']==len(cards)
print('AUDITORIA OK:',len(d['ediciones']),'ediciones,',len(pubs),'publicaciones,',len(cards),'tarjetas,',sum(len(p['reformas']) for p in pubs),'reformas')
print('perfiles relevantes:',sum(1 for t in cards for p in t['perfiles'] if p['relevante']))
