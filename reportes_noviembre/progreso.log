b=json.load(open('bodies.json'))
def grab(cod,pat,n=700,k=2):
    txt=re.sub(r'\s+',' ',' '.join(b[cod]))
    ms=list(re.finditer(pat,txt,re.I))
    print('---',cod,pat,len(ms))
    for m in ms[:k]: print(' *',txt[m.start():m.start()+n])
