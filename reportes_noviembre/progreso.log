import re,html,json
def parse(f):
    d=open(f,encoding='utf-8',errors='replace').read()
    d=re.sub(r'(?s)<script.*?</script>','',d)
    d=re.sub(r'(?s)<!--.*?-->','',d)
    # iterate tokens: sections, dependencies, publication anchors in order
    pat=re.compile(r'class="txt_blanco2"[^>]*>(?P<sec>.*?)</td>|class="subtitle_azul"[^>]*>(?P<dep>.*?)</td>|<a href="(?P<url>/nota_detalle\.php\?codigo=\d+&amp;fecha=[^"]+)" class="enlaces">(?P<title>.*?)</a>',re.S)
    sec=dep=None; out=[]
    for m in pat.finditer(d):
        if m.group('sec') is not None:
            sec=html.unescape(re.sub(r'<[^>]*>','',m.group('sec'))).strip()
        elif m.group('dep') is not None:
            dep=html.unescape(re.sub(r'<[^>]*>','',m.group('dep'))).strip()
        else:
            title=html.unescape(re.sub(r'\s+',' ',re.sub(r'<[^>]*>','',m.group('title')))).strip()
            out.append({'seccion':sec,'dependencia':dep,'url':'https://dof.gob.mx'+html.unescape(m.group('url')),'titulo':title})
    return out
